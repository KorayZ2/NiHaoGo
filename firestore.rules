rules_version = '2';

// NiHaoGo: each player owns one document, users/{uid}, written by ProgressSync (PLAN.md §3.3).
// Players can only touch their own document, and every write is checked against the shape the app sends.
// The client still decides coins and premium, so these rules stop junk data, not a determined cheater
// (moving the economy to Cloud Functions is planned for a later phase).
//
// Keep categoryIds() and sceneKeys() in step with assets/content/*.json, and the daily limits in step
// with GameRules, or new content will fail to sync.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isUser(request.resource.data) && createTimestampsOk();
      allow update: if isOwner(uid) && isUser(request.resource.data) && updateTimestampsOk();
      allow delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function categoryIds() {
      return ['greeting', 'numbers', 'family', 'food', 'school', 'shopping', 'travel', 'phone'];
    }

    // SpecialRules.sceneKey(modeId, index) for every special-mode scene.
    function sceneKeys() {
      return [
        'mansion/0', 'mansion/1', 'mansion/2', 'mansion/3',
        'doctor/0', 'doctor/1', 'doctor/2',
        'flight/0', 'flight/1', 'flight/2'
      ];
    }

    function isStars(n) {
      return n is int && n >= 0 && n <= 3;
    }

    function isCount(n, max) {
      return n is int && n >= 0 && n <= max;
    }

    function isUser(data) {
      return data.keys().hasOnly([
          'createdAt', 'updatedAt', 'coins', 'premium', 'progress',
          'unlocked', 'special', 'bossRetry', 'daily'
        ])
        && data.get('coins', 0) is int && data.get('coins', 0) >= 0
        && data.get('premium', false) is bool
        && isProgress(data.get('progress', {}))
        && data.get('unlocked', []) is list && data.get('unlocked', []).hasOnly(sceneKeys())
        && isSpecial(data.get('special', {}))
        && data.get('bossRetry', []) is list
        && data.get('bossRetry', []).hasOnly(categoryIds().concat(sceneKeys()))
        && isDaily(data.get('daily', {}));
    }

    // Best stars per step, per category: { greeting: { vocab, sentence, listening, boss }, ... }
    function isProgress(p) {
      return p is map && p.keys().hasOnly(categoryIds())
        && isCategory(p.get('greeting', {}))
        && isCategory(p.get('numbers', {}))
        && isCategory(p.get('family', {}))
        && isCategory(p.get('food', {}))
        && isCategory(p.get('school', {}))
        && isCategory(p.get('shopping', {}))
        && isCategory(p.get('travel', {}))
        && isCategory(p.get('phone', {}));
    }

    function isCategory(c) {
      return c is map && c.keys().hasOnly(['vocab', 'sentence', 'listening', 'boss'])
        && isStars(c.get('vocab', 0))
        && isStars(c.get('sentence', 0))
        && isStars(c.get('listening', 0))
        && isStars(c.get('boss', 0));
    }

    // Best stars per special-mode scene, keyed by scene key.
    function isSpecial(s) {
      return s is map && s.keys().hasOnly(sceneKeys())
        && isStars(s.get('mansion/0', 0))
        && isStars(s.get('mansion/1', 0))
        && isStars(s.get('mansion/2', 0))
        && isStars(s.get('mansion/3', 0))
        && isStars(s.get('doctor/0', 0))
        && isStars(s.get('doctor/1', 0))
        && isStars(s.get('doctor/2', 0))
        && isStars(s.get('flight/0', 0))
        && isStars(s.get('flight/1', 0))
        && isStars(s.get('flight/2', 0));
    }

    // Today's usage (GameRules.FREE_BOSS_RETRIES_PER_DAY = 1, GameRules.ADS_PER_DAY = 2).
    function isDaily(d) {
      return d is map && d.keys().hasOnly(['day', 'freeRetries', 'adsWatched'])
        && d.get('day', '') is string
        && (d.get('day', '') == '' || d.get('day', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && isCount(d.get('freeRetries', 0), 1)
        && isCount(d.get('adsWatched', 0), 2);
    }

    // Timestamps come from FieldValue.serverTimestamp(), which arrives as request.time.
    function createTimestampsOk() {
      let data = request.resource.data;
      return (!('createdAt' in data) || data.createdAt == request.time)
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    // createdAt is set once (also when an earlier write created the document without it).
    function updateTimestampsOk() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['createdAt'])
          || (!('createdAt' in resource.data) && data.createdAt == request.time))
        && (!changed.hasAny(['updatedAt']) || data.updatedAt == request.time);
    }
  }
}
